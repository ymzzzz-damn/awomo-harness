{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Piano skill structure",
  "type": "object",
  "required": [
    "schema",
    "id",
    "revision",
    "name",
    "category",
    "status",
    "purpose",
    "input_contract",
    "output_contract",
    "required_inputs",
    "effects",
    "dependencies",
    "implementation_refs",
    "parameters",
    "entry",
    "exit",
    "memory",
    "qualification",
    "composition",
    "preview"
  ],
  "properties": {
    "schema": {
      "const": "piano.skill.structure/v1"
    },
    "id": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "status": {
      "enum": [
        "planned",
        "experimental",
        "existing_component"
      ]
    },
    "purpose": {
      "type": "string"
    },
    "input_contract": {
      "type": "string"
    },
    "output_contract": {
      "type": "string"
    },
    "required_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "revision"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "implementation_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entry": {
      "type": "object"
    },
    "exit": {
      "type": "object"
    },
    "memory": {
      "type": "object"
    },
    "qualification": {
      "type": "object"
    },
    "composition": {
      "type": "object"
    },
    "preview": {
      "type": "null"
    }
  },
  "additionalProperties": false
}

{
  "schema": "piano.skill.structure/v1",
  "id": "idle-retraction",
  "revision": "structure-v1",
  "name": "闲置手指回收",
  "category": "primitives",
  "status": "existing_component",
  "purpose": "收回未分配手指，减少非目标键接触。",
  "input_contract": "piano.practice_context/v1",
  "output_contract": "piano.practice_context/v1",
  "required_inputs": [
    "target_key_set",
    "idle_fingers"
  ],
  "effects": [
    "simulation.hand_proposal"
  ],
  "dependencies": [
    {
      "id": "key-contact",
      "revision": "structure-v1"
    }
  ],
  "implementation_refs": [
    "robopianist/rsi/hand_controller.py"
  ],
  "parameters": [
    "contact_retract_unused",
    "contact_retract_weight"
  ],
  "entry": {
    "requires": [
      "source physical state and score window",
      "pinned controller and memory revisions"
    ],
    "validated_windows": []
  },
  "exit": {
    "preserves": [
      "full integration state",
      "acoustic history"
    ],
    "requires_recovery_validation": true
  },
  "memory": {
    "reads": [
      "experiences",
      "diagnostics",
      "progress"
    ],
    "writes": "candidate evidence through harness; no implicit active-state mutation"
  },
  "qualification": {
    "cross_piece_transfer_validated": false,
    "evidence_refs": [],
    "limitations": [
      "需连同下次触键评估，回收可能影响准备时间。"
    ]
  },
  "composition": {
    "mode": "serial",
    "parallel_live_piano_writers_allowed": false
  },
  "preview": null
}

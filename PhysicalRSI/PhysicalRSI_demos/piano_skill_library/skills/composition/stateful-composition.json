{
  "schema": "piano.skill.structure/v1",
  "id": "stateful-composition",
  "revision": "structure-v1",
  "name": "保留物理状态的片段组合",
  "category": "composition",
  "status": "existing_component",
  "purpose": "切换局部控制配置，保留积分状态和发声历史。",
  "input_contract": "piano.practice_context/v1",
  "output_contract": "piano.practice_context/v1",
  "required_inputs": [
    "ordered_segments",
    "entry_state",
    "exit_requirements"
  ],
  "effects": [
    "simulation.hand_proposal",
    "simulation.integration",
    "simulation.acoustic_history"
  ],
  "dependencies": [],
  "implementation_refs": [
    "robopianist/rsi/controller_schedule.py",
    "robopianist/rsi/continuation_config.py"
  ],
  "parameters": [
    "controller_schedule"
  ],
  "entry": {
    "requires": [
      "source physical state and score window",
      "pinned controller and memory revisions"
    ],
    "validated_windows": []
  },
  "exit": {
    "preserves": [
      "full integration state",
      "acoustic history"
    ],
    "requires_recovery_validation": true
  },
  "memory": {
    "reads": [
      "experiences",
      "diagnostics",
      "progress"
    ],
    "writes": "candidate evidence through harness; no implicit active-state mutation"
  },
  "qualification": {
    "cross_piece_transfer_validated": false,
    "evidence_refs": [],
    "limitations": [
      "已实现状态保留；片段可串接不代表全曲表现不退化。"
    ]
  },
  "composition": {
    "mode": "serial",
    "parallel_live_piano_writers_allowed": false
  },
  "preview": null
}

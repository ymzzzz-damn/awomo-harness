{
  "schema": "piano.skill.structure/v1",
  "id": "failure-driven-practice",
  "revision": "structure-v1",
  "name": "失败记忆驱动的短片段练习",
  "category": "learning",
  "status": "existing_component",
  "purpose": "从失败诊断挑选窗口，同入口对照、恢复段与全曲复验。",
  "input_contract": "piano.practice_context/v1",
  "output_contract": "piano.practice_context/v1",
  "required_inputs": [
    "diagnostics",
    "incumbent_ref",
    "practice_budget"
  ],
  "effects": [
    "memory.candidate_append",
    "skills.candidate_publish"
  ],
  "dependencies": [
    {
      "id": "stateful-composition",
      "revision": "structure-v1"
    }
  ],
  "implementation_refs": [
    "robopianist/rsi/continual.py",
    "examples/practice_exact_skill_candidates.py",
    "examples/audit_piano_onset_changes.py"
  ],
  "parameters": [
    "window_length",
    "recovery_length"
  ],
  "entry": {
    "requires": [
      "source physical state and score window",
      "pinned controller and memory revisions"
    ],
    "validated_windows": []
  },
  "exit": {
    "preserves": [
      "full integration state",
      "acoustic history"
    ],
    "requires_recovery_validation": true
  },
  "memory": {
    "reads": [
      "experiences",
      "diagnostics",
      "progress"
    ],
    "writes": "candidate evidence through harness; no implicit active-state mutation"
  },
  "qualification": {
    "cross_piece_transfer_validated": false,
    "evidence_refs": [],
    "limitations": [
      "现有自动筛选与人工审计并存；音符身份及音乐性要求尚非全部自动门禁。"
    ]
  },
  "composition": {
    "mode": "serial",
    "parallel_live_piano_writers_allowed": false
  },
  "preview": null
}

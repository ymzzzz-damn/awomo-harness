{
  "schema": "piano.skill.structure/v1",
  "id": "stable-hold",
  "revision": "structure-v1",
  "name": "持续音与稳定持键",
  "category": "articulation",
  "status": "experimental",
  "purpose": "目标集合不变时尝试保持姿态，减少重复触发。",
  "input_contract": "piano.practice_context/v1",
  "output_contract": "piano.practice_context/v1",
  "required_inputs": [
    "held_notes",
    "next_onset",
    "acoustic_history_ref"
  ],
  "effects": [
    "simulation.hand_proposal"
  ],
  "dependencies": [
    {
      "id": "key-contact",
      "revision": "structure-v1"
    }
  ],
  "implementation_refs": [
    "robopianist/rsi/ensemble_controller.py"
  ],
  "parameters": [
    "ensemble_hold_stable"
  ],
  "entry": {
    "requires": [
      "source physical state and score window",
      "pinned controller and memory revisions"
    ],
    "validated_windows": []
  },
  "exit": {
    "preserves": [
      "full integration state",
      "acoustic history"
    ],
    "requires_recovery_validation": true
  },
  "memory": {
    "reads": [
      "experiences",
      "diagnostics",
      "progress"
    ],
    "writes": "candidate evidence through harness; no implicit active-state mutation"
  },
  "qualification": {
    "cross_piece_transfer_validated": false,
    "evidence_refs": [],
    "limitations": [
      "长期恢复测试出现退化，不能作为已掌握的连奏技能。"
    ]
  },
  "composition": {
    "mode": "serial",
    "parallel_live_piano_writers_allowed": false
  },
  "preview": null
}

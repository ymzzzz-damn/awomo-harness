@@ -152,6 +152,22 @@ def _is_retryable(exc: Exception) -> bool:
     if status is not None and status in RETRYABLE_STATUS_CODES:
         return True
 
+    # Some OpenAI-compatible gateways (including local/custom providers) wrap
+    # transient upstream failures in a generic APIError without preserving an
+    # HTTP status code. Recognize only explicit transient messages; do not retry
+    # authentication, validation, or other permanent errors.
+    message = str(exc).lower()
+    if any(
+        marker in message
+        for marker in (
+            "upstream rate limit exceeded",
+            "rate limit exceeded, please retry",
+            "upstream request failed",
+            "an error occurred while processing your request. you can retry",
+        )
+    ):
+        return True
+
     return False
 
 
